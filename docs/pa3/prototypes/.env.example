DATABASE_USERNAME=debatespeak
DATABASE_PASSWORD=debatespeak_dev_password
APP_JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Only needed for recovery and verification emails
SPRING_MAIL_USERNAME=
