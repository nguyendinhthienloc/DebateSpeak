# Environment & Configuration Template
# Copy this file to .env and fill in your values.
# DO NOT COMMIT THE ACTUAL .env FILE!

# Application Environment
ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=

# Database (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Cache & Queue (Redis)
REDIS_URL=

# Authentication (JWT)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Real-Time Media (LiveKit SFU)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM Configuration (Provider & Model agnostic)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Speech-to-Text (STT) Configuration
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=

# Search / Fact-Checking Configuration
SEARCH_PROVIDER=
SEARCH_API_KEY=
