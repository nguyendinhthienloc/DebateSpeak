# Environment & Configuration Template
# Copy this file to .env and fill in your values.
# DO NOT COMMIT THE ACTUAL .env FILE!

# Application Environment
ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=

# Database (PostgreSQL)
# Local Docker default: user=debatespeak, pass=debatespeak_dev_password, db=debatespeak
POSTGRES_USER=debatespeak
POSTGRES_PASSWORD=debatespeak_dev_password
POSTGRES_DB=debatespeak
DATABASE_URL=postgresql+asyncpg://debatespeak:debatespeak_dev_password@localhost:5432/debatespeak

# Cache & Queue (Redis)
# Local Docker default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Authentication (JWT)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Real-Time Media (LiveKit SFU)
# Local Docker dev mode defaults: url=http://localhost:7880, key=devkey, secret=secret
# Or use your LiveKit Cloud project credentials: wss://your-subdomain.livekit.cloud
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LLM Configuration (Provider & Model agnostic)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Speech-to-Text (STT) Configuration
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=

# Search / Fact-Checking Configuration
SEARCH_PROVIDER=
SEARCH_API_KEY=
